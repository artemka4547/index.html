
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Заброшенный дом 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#000;color:white;font-family:monospace}
#hud{position:fixed;top:15px;left:15px;z-index:3;text-shadow:0 2px 5px black}
#message{position:fixed;top:45%;width:100%;text-align:center;font-size:24px;color:#f33;text-shadow:0 0 15px red;pointer-events:none}
#start{position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:10;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:20px}
button{background:#850000;border:1px solid red;color:white;padding:15px 25px;font-size:18px;margin:10px}
#controls{position:fixed;bottom:20px;left:15px;z-index:5;display:none}
#controls button{width:55px;height:55px;padding:0;background:#333a;font-size:23px}
#look{position:fixed;right:0;bottom:0;width:45%;height:55%;z-index:2}
</style>
</head>
<body>
<div id="hud">🔦 ФОНАРИК: <span id="battery">100</span>%<br>🔑 КЛЮЧИ: <span id="keys">0</span>/3</div>
<div id="message"></div>
<div id="start">
<h1 style="color:#b00;font-size:35px">ЗАБРОШЕННЫЙ ДОМ</h1>
<p>Ты проснулся в неизвестном доме.</p>
<p>Найди 3 ключа и выберись.</p>
<p>Но здесь ты не один...</p>
<button onclick="begin()">НАЧАТЬ ИГРУ</button>
<p>WASD — ходить | Мышь — смотреть | Shift — бежать</p>
<p>На телефоне — кнопки движения и касание экрана для осмотра.</p>
</div>
<div id="controls">
<div><button id="forward">▲</button></div>
<div><button id="left">◀</button><button id="back">▼</button><button id="right">▶</button></div>
</div>
<div id="look"></div>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x020203);
scene.fog=new THREE.FogExp2(0x050506,.045);
const camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.1,80);
camera.position.set(0,1.7,0);
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0x454550,0x090909,.35));
const light=new THREE.PointLight(0xffe5bd,2,9);
camera.add(light);scene.add(camera);

const flashlight=new THREE.SpotLight(0xffe9c5,65,24,.35,.5,1);
camera.add(flashlight);
flashlight.position.set(0,0,0);
flashlight.target.position.set(0,0,-1);
camera.add(flashlight.target);

const wallMat=new THREE.MeshStandardMaterial({color:0x292725,roughness:1});
const floorMat=new THREE.MeshStandardMaterial({color:0x171615,roughness:1});
const objects=[];
function box(x,y,z,w,h,d,mat,solid=true){
const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;
scene.add(m);if(solid)objects.push({x,z,w,d});return m;
}
box(0,-.2,0,40,.4,40,floorMat,false);
box(0,4,0,40,.3,40,wallMat,false);

// Дом и коридоры
const grid=[
"####################",
"#........#.........#",
"#........#.........#",
"#........#.........#",
"####.#####.####.####",
"#.................#",
"#.................#",
"#.####.#######.##..#",
"#..................#",
"#..................#",
"####.####.####.#####",
"#........#.........#",
"#........#.........#",
"#.................#",
"#.................#",
"####################"
];
const size=2,offset=10;
for(let z=0;z<grid.length;z++){
for(let x=0;x<grid[z].length;x++){
if(grid[z][x]==='#'){
box((x-offset)*size,1.5,(z-8)*size,2,3,2,wallMat);
}
}
}
// Потолок
box(0,3.1,0,40,.2,40,new THREE.MeshStandardMaterial({color:0x101010}),false);

// Светильники
for(let z=0;z<16;z+=4){
const l=new THREE.PointLight(0x9a8580,2,8);
l.position.set(0,2.7,(z-8)*2);
scene.add(l);
const bulb=new THREE.Mesh(new THREE.SphereGeometry(.09),new THREE.MeshBasicMaterial({color:0xffaaaa}));
bulb.position.copy(l.position);scene.add(bulb);
}

// Ключи
const pickups=[];
const keyPositions=[[-7,-7],[7,3],[-5,9]];
for(const [x,z] of keyPositions){
const g=new THREE.Group();
const ring=new THREE.Mesh(new THREE.TorusGeometry(.23,.065,8,18),new THREE.MeshStandardMaterial({color:0xffcc33,metalness:.8}));
g.add(ring);
const stem=new THREE.Mesh(new THREE.BoxGeometry(.09,.4,.09),ring.material);
stem.position.y=-.25;g.add(stem);
g.position.set(x,1,z);scene.add(g);pickups.push(g);
}

// Выход
const exit=box(8,1.4,14,1,2.8,.3,new THREE.MeshStandardMaterial({color:0x321010}),false);
const exitLight=new THREE.PointLight(0xff0000,3,5);
exitLight.position.set(8,2,13);scene.add(exitLight);

// Монстр
const monster=new THREE.Group();
const skin=new THREE.MeshStandardMaterial({color:0x100b0b,roughness:1});
const body=new THREE.Mesh(new THREE.BoxGeometry(.85,1.8,.5),skin);
body.position.y=1;monster.add(body);
const head=new THREE.Mesh(new THREE.SphereGeometry(.43,12,12),skin);
head.position.y=2.1;monster.add(head);
const eyeMat=new THREE.MeshBasicMaterial({color:0xff0000});
for(let x of [-.17,.17]){
const eye=new THREE.Mesh(new THREE.SphereGeometry(.075),eyeMat);
eye.position.set(x,2.15,-.38);monster.add(eye);
}
monster.position.set(7,0,-12);scene.add(monster);

let yaw=0,pitch=0,keys={},count=0,battery=100;
let running=false,dead=false,won=false,flashOn=true;
const msg=document.getElementById('message');
function say(t){msg.textContent=t;}
function begin(){
document.getElementById('start').style.display='none';
running=true;
if(innerWidth<800)document.getElementById('controls').style.display='block';
else renderer.domElement.requestPointerLock?.();
}
document.addEventListener('keydown',e=>{
keys[e.key.toLowerCase()]=true;
if(e.key.toLowerCase()==='f')flashOn=!flashOn;
if(e.key==='Shift')keys.shift=true;
});
document.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
document.addEventListener('mousemove',e=>{
if(document.pointerLockElement===renderer.domElement){
yaw-=e.movementX*.002;
pitch-=e.movementY*.002;
pitch=Math.max(-1.3,Math.min(1.3,pitch));
}
});
renderer.domElement.addEventListener('click',()=>{
if(running&&innerWidth>=800&&!document.pointerLockElement)renderer.domElement.requestPointerLock?.();
});
let touchX=0,touchY=0;
const look=document.getElementById('look');
look.addEventListener('touchstart',e=>{
touchX=e.touches[0].clientX;touchY=e.touches[0].clientY;
},{passive:true});
look.addEventListener('touchmove',e=>{
let t=e.touches[0];
yaw-=(t.clientX-touchX)*.008;
pitch-=(t.clientY-touchY)*.008;
pitch=Math.max(-1.3,Math.min(1.3,pitch));
touchX=t.clientX;touchY=t.clientY;
},{passive:true});
function bind(id,k){
const b=document.getElementById(id);
b.addEventListener('touchstart',e=>{e.preventDefault();keys[k]=true},{passive:false});
b.addEventListener('touchend',()=>keys[k]=false);
b.addEventListener('mousedown',()=>keys[k]=true);
b.addEventListener('mouseup',()=>keys[k]=false);
}
bind('forward','w');bind('back','s');bind('left','a');bind('right','d');

function blocked(x,z){
for(const o of objects){
if(Math.abs(x-o.x)<o.w/2+.3&&Math.abs(z-o.z)<o.d/2+.3)return true;
}
return false;
}
function finish(text){
dead=true;running=false;say(text);
document.exitPointerLock?.();
const b=document.createElement('button');
b.textContent='ИГРАТЬ СНОВА';
b.onclick=()=>location.reload();
document.body.appendChild(b);
}
const clock=new THREE.Clock();
function animate(){
requestAnimationFrame(animate);
let dt=Math.min(clock.getDelta(),.05);
if(running&&!dead&&!won){
camera.rotation.order='YXZ';
camera.rotation.set(pitch,yaw,0);
const speed=keys.shift?5:2.8;
let dx=0,dz=0;
if(keys.w||keys.arrowup)dz-=1;
if(keys.s||keys.arrowdown)dz+=1;
if(keys.a||keys.arrowleft)dx-=1;
if(keys.d||keys.arrowright)dx+=1;
const len=Math.hypot(dx,dz)||1;
dx/=len;dz/=len;
let vx=(dx*Math.cos(yaw)+dz*Math.sin(yaw))*speed*dt;
let vz=(-dx*Math.sin(yaw)+dz*Math.cos(yaw))*speed*dt;
if(!blocked(camera.position.x+vx,camera.position.z))camera.position.x+=vx;
if(!blocked(camera.position.x,camera.position.z+vz))camera.position.z+=vz;
camera.position.y=1.7;

// Сбор ключей
for(let i=pickups.length-1;i>=0;i--){
const p=pickups[i];
p.rotation.y+=dt*2;
if(camera.position.distanceTo(p.position)<1.3){
scene.remove(p);pickups.splice(i,1);count++;
document.getElementById('keys').textContent=count;
say('ТЫ НАШЁЛ КЛЮЧ!');
setTimeout(()=>{if(running)say(''),1200);
}
}

// Монстр преследует
const dxm=camera.position.x-monster.position.x;
const dzm=camera.position.z-monster.position.z;
const dist=Math.hypot(dxm,dzm);
if(dist<15){
monster.position.x+=dxm/dist*dt*(dist<5?2.3:1.35);
monster.position.z+=dzm/dist*dt*(dist<5?2.3:1.35);
monster.rotation.y=Math.atan2(dxm,dzm);
}
if(dist<1.1)finish('ОН ПОЙМАЛ ТЕБЯ...');
if(dist<7&&Math.random()<.005)say('ТЫ СЛЫШИШЬ ШАГИ...');
if(dist>=7&&msg.textContent==='ТЫ СЛЫШИШЬ ШАГИ...')say('');

// Фонарик
if(flashOn&&battery>0){
battery-=dt*.7;light.intensity=1.5;
}else{light.intensity=.1;}
flashlight.intensity=flashOn&&battery>0?65:0;
document.getElementById('battery').textContent=Math.max(0,Math.floor(battery));

// Выход
if(camera.position.distanceTo(exit.position)<2){
if(count===3){
won=true;running=false;say('ТЫ ВЫБРАЛСЯ! ТЫ ВЫЖИЛ!');
}else say('НУЖНЫ ВСЕ ТРИ КЛЮЧА!');
}
}
renderer.render(scene,camera);
}
animate();
addEventListener('resize',()=>{
camera.aspect=innerWidth/innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
